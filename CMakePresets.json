{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-live-vs2026",
      "displayName": "Sonkupik Live - Visual Studio 2026",
      "description": "Requires CMake 4.2 or newer and Visual Studio 2026 Desktop development with C++.",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-live-vs2026",
      "cacheVariables": {
        "SONKUPIK_ASKP_SOURCE_DIR": "$env{ASKP_SOURCE_DIR}"
      }
    },
    {
      "name": "windows-live-ninja",
      "displayName": "Sonkupik Live - Ninja + MSVC",
      "description": "Run from a Visual Studio x64 Developer PowerShell/Command Prompt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-live-ninja",
      "cacheVariables": {
        "SONKUPIK_ASKP_SOURCE_DIR": "$env{ASKP_SOURCE_DIR}",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-live-vs2026-release",
      "configurePreset": "windows-live-vs2026",
      "configuration": "Release",
      "targets": [
        "SonkupikLive"
      ],
      "jobs": 0
    },
    {
      "name": "windows-live-ninja-release",
      "configurePreset": "windows-live-ninja",
      "targets": [
        "SonkupikLive"
      ],
      "jobs": 0
    }
  ]
}
